{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  // Сессия стартует с оркестратора рабочей группы
  "default_agent": "lead",
  // Wave 0 T-15: автоформат через харнесс (без package.json активен только
  // rustfmt для .rs; markdown/JSON не затрагиваются). Поле instructions
  // убрано как мёртвое в V2 (AGENTS.md подхватывается автоматически).
  "formatter": true,

  // Провайдер моделей
  "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "router ai",
      "options": {
        "baseURL": "https://routerai.ru/api/v1"
      },
      "models": {
        "~deepseek/deepseek-v4-flash-latest": {
          "name": "~deepseek/deepseek-v4-flash-latest"
        },
        "~deepseek/deepseek-v4-pro-latest": {
          "name": "~deepseek/deepseek-v4-pro-latest"
        },
        "deepseek/deepseek-v3.2": {
          "name": "deepseek/deepseek-v3.2"
        },
        "qwen/qwen3-coder-plus": {
          "name": "qwen/qwen3-coder-plus"
        }
      }
    }
  },

  // MCP-серверы проекта (формат OpenCode V2: mcp.servers)
  "mcp": {
    "servers": {
      "rust-analyzer": {
        "type": "local",
        "command": ["rust-analyzer-mcp", "C:/Users/Demon/pytechnotes/dar/credo2"],
        "environment": {
          "RUST_BACKTRACE": "1"
        }
      },
      "credo": {
        "type": "local",
        "command": [
          "C:/Users/Demon/pytechnotes/dar/credo2/target/release/credo2.exe",
          "--workspace",
          "C:/Users/Demon/pytechnotes/dar/credo2"
        ],
        "environment": {
          "RUST_BACKTRACE": "1",
          "RUST_LOG": "info"
        }
      }
    }
  }
}
